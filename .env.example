# Puerto y entorno
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL (Neon)
DATABASE_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/jinstock?sslmode=require"
DIRECT_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/jinstock?sslmode=require"

# Seguridad y Autenticación JWT (Obligatorio - Definir clave secreta segura de al menos 32 caracteres)
JWT_SECRET="CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_MINIMO_32_CARACTERES"

# Control de Origen CORS (Frontend)
CORS_ORIGIN="http://localhost:5173"

# Servicio de Correo SMTP (Opcional para confirmaciones de correo)
SMTP_USER="usuario@gmail.com"
SMTP_PASS="password_de_aplicacion"

# URL de API para Frontend
VITE_API_URL="http://localhost:4000/api"

# Parámetros del Negocio
IVA_PERCENTAGE=15
DEFAULT_EXCHANGE_RATE_USD=36.62
