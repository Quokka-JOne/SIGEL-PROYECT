# ==============================================================
# JINStock (SIGEL) - Plantilla de Variables de Entorno (Monorepo)
# ==============================================================

# --------------------------------------------------------------
# BACKEND (Express + TypeScript + Prisma)
# --------------------------------------------------------------

# Puerto de escucha del servidor y entorno
PORT=4000
NODE_ENV=development # En Render configurar: production

# Base de datos PostgreSQL (Neon) [OBLIGATORIO]
DATABASE_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/jinstock?sslmode=require"
DIRECT_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/jinstock?sslmode=require"

# Llave secreta de firma JWT [OBLIGATORIO - mínimo 32 caracteres]
# El backend fallará al iniciar si falta esta variable
JWT_SECRET="CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_MINIMO_32_CARACTERES"

# Orígenes permitidos CORS [OBLIGATORIO EN PRODUCCIÓN]
# En NODE_ENV=production, si falta o es '*', el backend fallará al iniciar por seguridad
CORS_ORIGIN="http://localhost:5173,https://jinstock-proyect.pages.dev"

# Credenciales del Administrador Inicial [OPCIONAL]
# Si se definen y el usuario no existe, se crea automáticamente al arrancar
INITIAL_ADMIN_EMAIL="admin@jinstock.ni"
INITIAL_ADMIN_PASSWORD="CambiarEstaPasswordSegura2026!"
INITIAL_ADMIN_NAME="Administrador General JINStock"

# Keep-Alive para bases de datos Neon [OPCIONAL]
# Envía un ping 'SELECT 1' periódico para evitar el sleep del tier gratuito de Neon
ENABLE_KEEP_ALIVE="true"
KEEP_ALIVE_INTERVAL_MS="180000" # 3 minutos

# Servicio de Correo SMTP para confirmaciones [OPCIONAL]
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="usuario@gmail.com"
SMTP_PASS="password_de_aplicacion"

# Parámetros del Negocio
IVA_PERCENTAGE=15
DEFAULT_EXCHANGE_RATE_USD=36.62

# --------------------------------------------------------------
# FRONTEND (React + Vite PWA)
# --------------------------------------------------------------
# URL del backend al que se conectará el frontend [OBLIGATORIO EN FRONTEND]
# En Cloudflare Pages configurar: https://jinstock-proyect.onrender.com/api
VITE_API_URL="http://localhost:4000/api"
