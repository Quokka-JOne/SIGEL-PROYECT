# Frontend de JINStock — copiá este archivo a .env.local y ajustá la URL.
#
# ADVERTENCIA: todo lo que lleve el prefijo VITE_ queda embebido en el bundle
# y es visible para cualquiera que abra el navegador. Acá NO va ningún secreto:
# ni GEMINI_API_KEY ni DATABASE_URL ni JWT_SECRET (README §17, §18).

VITE_API_URL="http://localhost:3000"
