# ==========================================
# JINStock Backend - Variables de Entorno
# ==========================================

# Puerto y entorno
PORT=4000
NODE_ENV=development # O 'production' en Render

# Base de datos PostgreSQL (Neon) - OBLIGATORIO
DATABASE_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/jinstock?sslmode=require"
DIRECT_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/jinstock?sslmode=require"

# Seguridad y Autenticación JWT - OBLIGATORIO (Mínimo 32 caracteres)
JWT_SECRET="CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_MINIMO_32_CARACTERES"

# Control de Origen CORS - OBLIGATORIO EN PRODUCCIÓN (No se permite '*' en producción)
# En producción especificar la URL exacta de Cloudflare Pages separada por comas si hay varias:
CORS_ORIGIN="http://localhost:5173,https://jinstock-proyect.pages.dev"

# Saltos de proxy confiables (Cloudflare -> Render Ingress -> contenedor = 2).
# Evita que el cliente pueda evadir los rate limits falsificando su IP.
TRUST_PROXY_HOPS="2"

# Reutilización del resultado saludable del health check durante 5 segundos.
HEALTH_CACHE_TTL_MS="5000"

# Administrador Inicial (Opcional - para auto-creación del primer admin sin seed manual)
INITIAL_ADMIN_EMAIL="admin@jinstock.ni"
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador General JINStock"

# Neon PostgreSQL Keep-Alive (Opcional - evita desconexión por inactividad de Neon Free Tier)
ENABLE_KEEP_ALIVE="true"
KEEP_ALIVE_INTERVAL_MS="180000" # 3 minutos

# Servicio de Correo SMTP (Opcional para envío de confirmaciones)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="usuario@gmail.com"
SMTP_PASS="password_de_aplicacion"
