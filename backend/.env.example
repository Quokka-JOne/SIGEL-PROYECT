# Backend de JINStock — copiá este archivo a .env y completá los valores.
# .env está en .gitignore: los valores reales NUNCA se suben a GitHub (README §18).

# Cadena de conexión de Neon PostgreSQL.
# Usá el "Pooled connection" de Neon para la app en Vercel.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/jinstock?sslmode=require"

# Conexión directa (sin pooler). Prisma la usa para migraciones y shadow DB.
DIRECT_URL="postgresql://usuario:password@host.neon.tech/jinstock?sslmode=require"

# Secreto para firmar los JWT. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# API Key de Gemini. Vive SOLO acá: el frontend nunca habla con Gemini (README §17).
GEMINI_API_KEY=""

# Origen permitido por CORS. En producción, la URL del frontend en Vercel.
CORS_ORIGIN="http://localhost:5173"

PORT=3000
NODE_ENV="development"
