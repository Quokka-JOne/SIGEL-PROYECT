// JINStock — modelo físico
//
// Fuente conceptual: docs/especificacion.md §20. Las decisiones y su justificación
// están documentadas en docs/modelo-datos.md. Si cambiás algo acá, actualizá
// ese documento: la especificación §31 exige que el diseño conceptual y lógico exista
// también en la documentación.
//
// Convenciones:
//   - Modelos en español (especificación §20); rutas REST en inglés (especificación §21).
//     El mapeo entre ambos está en docs/api.md.
//   - Tablas y columnas en snake_case vía @@map / @map.
//   - Dinero en Decimal(12,2). Nunca Float: la correctitud de ventas e
//     inventario es la prioridad 1 de la especificación §30.
//   - Cantidades en Int: se venden unidades de papelería, no fracciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión con pooler de Neon, usada por la aplicación en runtime.
  url       = env("DATABASE_URL")
  // Conexión directa, usada por `prisma migrate` y la shadow database.
  // Neon no admite DDL a través del pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Autenticación y autorización
// ---------------------------------------------------------------------------

/// Roles del sistema. JINStock define exactamente dos (especificación §4) y el §28
/// prohíbe un tercero. Se modela como tabla porque el §20 lo declara entidad.
model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(20) // ADMINISTRADOR | CAJERO
  descripcion String? @db.VarChar(160)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id             Int     @id @default(autoincrement())
  nombreUsuario  String  @unique @map("nombre_usuario") @db.VarChar(40)
  nombreCompleto String  @map("nombre_completo") @db.VarChar(120)
  correo         String? @unique @db.VarChar(160)
  /// Hash bcrypt. Nunca se expone en respuestas de la API (especificación §17).
  passwordHash   String  @map("password_hash") @db.VarChar(120)
  activo         Boolean @default(true)

  rolId Int @map("rol_id")
  rol   Rol @relation(fields: [rolId], references: [id])

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  compras     Compra[]
  ventas      Venta[]
  movimientos MovimientoInventario[]

  @@index([rolId])
  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(60)
  descripcion String? @db.VarChar(200)
  activo      Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id     Int     @id @default(autoincrement())
  /// Código de barras o código interno. Opcional (especificación §5.2), pero único
  /// cuando existe: es la clave de búsqueda del POS.
  codigo String? @unique @db.VarChar(40)
  nombre String  @db.VarChar(160)

  descripcion String? @db.VarChar(400)

  categoriaId Int       @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  /// Precio de referencia actual. Los detalles de compra/venta guardan su
  /// propia copia para que el historial no cambie al ajustar precios.
  precioCompra Decimal @map("precio_compra") @db.Decimal(12, 2)
  precioVenta  Decimal @map("precio_venta") @db.Decimal(12, 2)

  /// Valor denormalizado, mantenido dentro de las transacciones de compra y
  /// venta. MovimientoInventario es el libro mayor para reconciliar.
  stockActual Int @default(0) @map("stock_actual")
  stockMinimo Int @default(0) @map("stock_minimo")

  /// Baja lógica. La especificación §5.2 prohíbe borrar productos con movimientos.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  detallesCompra DetalleCompra[]
  detallesVenta  DetalleVenta[]
  movimientos    MovimientoInventario[]

  @@index([categoriaId])
  @@index([activo])
  // Soporta "productos con stock bajo" y "agotados" (especificación §5.2, §10).
  @@index([stockActual])
  @@map("productos")
}

model Proveedor {
  id        Int     @id @default(autoincrement())
  nombre    String  @db.VarChar(160)
  telefono  String? @db.VarChar(40)
  correo    String? @db.VarChar(160)
  direccion String? @db.VarChar(240)
  activo    Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  compras Compra[]

  @@map("proveedores")
}

// ---------------------------------------------------------------------------
// Compras (entradas de inventario)
// ---------------------------------------------------------------------------

enum EstadoCompra {
  CONFIRMADA
  ANULADA
}

model Compra {
  id Int @id @default(autoincrement())

  proveedorId Int       @map("proveedor_id")
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  /// Administrador que registró la compra (especificación §8).
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  /// Fecha del documento de compra; puede ser anterior al registro.
  fecha DateTime @default(now())
  /// Suma de los subtotales de los detalles. Se calcula en el servidor.
  total Decimal  @db.Decimal(12, 2)

  estado EstadoCompra @default(CONFIRMADA)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  detalles DetalleCompra[]

  @@index([proveedorId])
  @@index([usuarioId])
  @@index([fecha])
  @@map("compras")
}

model DetalleCompra {
  id Int @id @default(autoincrement())

  compraId Int    @map("compra_id")
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad      Int
  /// Copia histórica del costo al momento de la compra.
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  // Un producto no se repite dentro de la misma compra: se consolida la
  // cantidad. Evita líneas duplicadas por doble clic o por reintento de sync.
  @@unique([compraId, productoId])
  @@index([productoId])
  @@map("detalles_compra")
}

// ---------------------------------------------------------------------------
// Ventas (salidas de inventario, punto de venta)
// ---------------------------------------------------------------------------

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

model Venta {
  /// Sirve además como número de comprobante legible (especificación §9).
  id Int @id @default(autoincrement())

  /// UUID generado en el cliente para TODA venta, con o sin conexión
  /// (especificación §12, §13). Es lo que hace idempotente a POST /api/sales:
  /// un reintento con la misma clave devuelve la venta ya registrada en
  /// lugar de crear un duplicado.
  claveIdempotencia String @unique @map("clave_idempotencia") @db.Uuid

  /// Cajero o administrador que registró la venta.
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  /// Momento real de la venta, tomado del reloj del cliente. En una venta
  /// offline puede ser horas anterior a `creadoEn`.
  fecha DateTime
  total Decimal  @db.Decimal(12, 2)

  metodoPago MetodoPago  @map("metodo_pago")
  estado     EstadoVenta @default(COMPLETADA)

  /// Momento en que el servidor persistió la venta. Comparado con `fecha`
  /// permite auditar el desfase de las ventas sincronizadas.
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  detalles DetalleVenta[]

  @@index([usuarioId])
  @@index([fecha])
  @@map("ventas")
}

model DetalleVenta {
  id Int @id @default(autoincrement())

  ventaId Int   @map("venta_id")
  venta   Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad       Int
  /// Copia histórica del precio al momento de la venta. El servidor lo
  /// revalida contra Producto.precioVenta al sincronizar (especificación §13).
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  @@unique([ventaId, productoId])
  @@index([productoId])
  @@map("detalles_venta")
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum OrigenMovimiento {
  COMPRA
  VENTA
  AJUSTE_MANUAL
}

/// Libro mayor de inventario. Se escribe siempre dentro de la misma
/// transacción que modifica Producto.stockActual, de modo que el stock
/// denormalizado sea reconstruible sumando los movimientos.
model MovimientoInventario {
  id Int @id @default(autoincrement())

  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  tipo   TipoMovimiento
  origen OrigenMovimiento

  /// Siempre positiva; el signo lo determina `tipo`.
  cantidad Int

  /// Stock antes y después del movimiento. Suficiente para el "historial
  /// básico" de la especificación §10 sin caer en la auditoría avanzada que el §28
  /// excluye del MVP.
  stockAnterior Int @map("stock_anterior")
  stockNuevo    Int @map("stock_nuevo")

  /// Referencia débil al documento que originó el movimiento: id de Compra
  /// cuando origen=COMPRA, id de Venta cuando origen=VENTA, null si es
  /// AJUSTE_MANUAL. No es FK porque apunta a dos tablas distintas.
  referenciaId Int? @map("referencia_id")

  /// Usuario responsable. Null solo si el movimiento lo generó un proceso
  /// automático sin sesión asociada.
  usuarioId Int?     @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  nota String? @db.VarChar(240)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([productoId, creadoEn])
  @@index([origen, referenciaId])
  @@map("movimientos_inventario")
}
